# vole configuration. Copy to ~/.config/vole/config.yaml and edit to taste.
# Any field may be omitted — defaults are used for missing ones.

# Input/output backend:
#   auto     (default) Wayland if WAYLAND_DISPLAY / XDG_SESSION_TYPE=wayland, else X11
#   x11      XGrabKey hotkey + floating overlay
#   wayland  GlobalShortcuts portal + tray only
# Override with the VOLE_BACKEND env var.
backend: auto

# Text injection method:
#   auto   (default) type on X11, paste on Wayland
#   type   xdotool types the text (only correct on a real X server; on KWin
#          Wayland the active layout garbles non-Latin text, e.g. Cyrillic)
#   paste  put the text on the clipboard and paste it with a keystroke
#          (layout-independent; the only correct option for Cyrillic on KWin).
#          Clipboard backend auto-detected: Klipper / wl-copy / xclip / xsel.
inject: auto

# Paste keystroke for inject=paste (xdotool key syntax). Default Shift+Insert
# (works in most GUI apps); terminals (Konsole) may need ctrl+shift+v.
# paste_key: shift+Insert

# inject=paste only: auto-paste after dictation. false = just put it on the
# clipboard and paste it yourself. Clicking a history entry always pastes.
auto_paste: true

# Post-processing: an external script that receives the raw transcript on stdin
# and returns an improved version on stdout (e.g. punctuation/case cleanup, or an
# LLM call). The script runs as an executable directly — it needs a shebang
# (#!/bin/sh, #!/usr/bin/env python3, …) and the execute bit. With post-processing
# on, the improved text is pasted into the focused window and both the raw and the
# improved text land on the clipboard (raw as the previous Klipper entry) and in
# the history. If the script fails, times out, or returns empty output, the raw
# transcript is used as before. See PostProcessing/Examples/ for ready-made
# scripts you can copy (e.g. ollama-qwen-cloud-vision-repair.py). Env: VOLE_POSTPROCESS.
# postprocess: ~/.config/vole/postprocess.sh
# Enable at startup; toggle at runtime via the tray "Post-process" checkbox
# (shown only when a script is configured). Default off.
# postprocess_on: false

# Seconds the post-processing script may run before it is killed. Cloud/vision
# scripts (a screenshot upload + a remote model) can take several seconds, so the
# default is generous. On timeout vole falls back to the raw transcript.
# postprocess_timeout: 30

# Seed whisper with the previous dictation as its initial_prompt. This biases
# recognition toward the active vocabulary/topic and notably steadies short,
# otherwise-ambiguous phrases — a cheap, local, offline lever independent of the
# post-processing script. Default on.
# whisper_prompt: true

# Translate mode for the alt/shift language (the "dictate-alt" shortcut). When
# on, that shortcut translates speech into English: whisper transcribes with
# the PRIMARY language pinned (the "dictate" language — e.g. Russian), then the
# post-process script translates the clean source transcript to English (it is
# invoked with VOLE_PP_TRANSLATE=1 and switches to a translate prompt). The
# "dictate" shortcut is unaffected — it still transcribes in its own language.
# Requires a post-process script that honors VOLE_PP_TRANSLATE (see
# PostProcessing/Examples). In translate mode no initial_prompt is seeded and the
# script runs even if the post-process tray toggle is off (translate needs it).
# Default off.
# translate: false

# PTT hotkey: hold to record, release to transcribe and inject.
#
# X11: while the key is held, Shift switches the language on the fly
# (lang <-> lang_shift). mods/key bind the actual key here.
#
# Wayland: the portal cannot observe a live Shift, so vole registers two
# shortcuts — "dictate" (lang) and "dictate-alt" (lang_shift) — that you assign
# in System Settings → Shortcuts. There mods/key only seed the *suggested*
# trigger: "dictate" gets mods+key and "dictate-alt" gets mods+Shift+key (KDE may
# pre-fill it; you can still override). E.g. mods: Super, key: k → Meta+K / Meta+Shift+K.
hotkey:
  mods: Super+Control   # modifiers: Super, Control, Alt, Shift (joined with +)
  key: d                # key (a Latin letter/digit, or space/pause/menu)
  lang: ru              # language without Shift / "dictate" shortcut
  lang_shift: en        # language while Shift is held / "dictate-alt" shortcut

# Silence threshold (peak RMS): recordings below it count as empty and are
# skipped. Lower it if quiet/whispered speech is dropped.
silence_threshold: 0.005

# VAD speech-probability threshold [0,1]: lower catches quieter/whispered speech
# (default 0.3; whisper's own default is 0.5).
vad_threshold: 0.3

# Recent dictations: shown in the tray menu (click one to paste it) and persisted.
history_size: 256
# history_file: ~/.local/state/vole/history.jsonl

# Model paths (~ is supported). Defaults to the whisper.cpp build directory.
model: ~/.local/share/dictation/whisper.cpp/models/ggml-large-v3.bin
vad: ~/.local/share/dictation/whisper.cpp/models/ggml-silero-v5.1.2.bin

# Daemon unix socket (defaults to $XDG_RUNTIME_DIR/vole.sock).
# socket: /run/user/1000/vole.sock

# Debug: dump the raw captured audio of each dictation as a WAV beside this path
# (16 kHz mono, before silence/VAD/transcription). Files are timestamped siblings,
# e.g. record-20260630-131815.007.wav. Empty = off. Env: VOLE_RECORD. Useful for
# inspecting dropped or misheard recordings.
# debug_record: ~/.local/state/vole/record.wav
# How many recent raw recordings to keep (older ones are pruned). Default 3.
# debug_record_keep: 3
